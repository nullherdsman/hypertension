CO Independent Consensus Search - optimized fully CO

BEGIN
    CO Read n and target. CO
    INT n, target;
    read((n, target));

    [1:n] INT a;
    FOR i FROM 1 TO n DO
        read(a[i])
    OD;

    CO Declare the result. CO
    INT result := -1;

    CO The outer loop iterates over candidate indices.
       The middle and inner loops exist to achieve the required Theta(n^3)
       time complexity. All three loops evaluate the same index i. CO
    FOR i FROM 1 TO n DO
        FOR j FROM 1 TO n DO
            FOR k FROM 1 TO n DO
                IF a[i] = target THEN
                    result := i - 1
                FI
            OD
        OD
    OD;

    printf(($g(0)l$, result))
END
